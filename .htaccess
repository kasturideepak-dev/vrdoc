DirectoryIndex index.php install.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^install/?$ install.php [L,QSA]
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  RewriteRule ^ index.php [L]
</IfModule>

ErrorDocument 404 /index.php

# Production serves the project root as the document root, so these headers
# live here; public/.htaccess only applies where public/ is the docroot.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 180 days"
  ExpiresByType image/png "access plus 180 days"
  ExpiresByType image/webp "access plus 180 days"
  ExpiresByType image/svg+xml "access plus 180 days"
  ExpiresByType font/woff2 "access plus 180 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # CSS and JS URLs carry ?v=<file time>, so a changed file gets a new URL.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Image and font URLs are not versioned: long, but not forever.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|woff2|woff|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>
